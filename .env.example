# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it is ignored by .gitignore.

# --- Public Supabase config (safe to expose to the browser) ---
# These are the same anon/publishable values already used by the Supabase
# JS SDK on the client, so leaking them is expected/normal — just don't
# put the service role key in any VITE_-prefixed variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Same values, read on the server (SSR) side.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# --- Server-only secret (NEVER expose to the client / never prefix with VITE_) ---
# Required by src/lib/whatsapp-stats.functions.ts and src/lib/store-report.functions.ts
# to read the whatsapp_clicks table with elevated privileges after verifying
# the caller is an admin. Get it from Supabase dashboard > Project Settings > API.
SUPABASE_SERVICE_ROLE_KEY=
